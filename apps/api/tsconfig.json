{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@rme/contracts": ["../../packages/contracts/src/index.ts"],
      "@rme/contracts/*": ["../../packages/contracts/src/*"]
    },
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "references": [{ "path": "../../packages/contracts" }]
}
