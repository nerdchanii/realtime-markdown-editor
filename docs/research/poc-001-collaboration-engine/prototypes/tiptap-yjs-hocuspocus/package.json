{
  "name": "@poc/tiptap-yjs-hocuspocus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "dev:all": "concurrently -n server,web -c cyan,green \"npm:server\" \"npm:dev\"",
    "server": "tsx watch server/hocuspocus.ts",
    "dev:server": "tsx watch server/hocuspocus.ts",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "test": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173"
  },
  "dependencies": {
    "@poc/shared": "workspace:*",
    "@hocuspocus/provider": "^3.2.3",
    "@hocuspocus/server": "^3.2.3",
    "@tiptap/extension-collaboration": "^3.4.1",
    "@tiptap/extension-collaboration-caret": "^3.4.1",
    "@tiptap/extension-link": "^3.4.1",
    "@tiptap/extension-table": "^3.4.1",
    "@tiptap/extension-table-cell": "^3.4.1",
    "@tiptap/extension-table-header": "^3.4.1",
    "@tiptap/extension-table-row": "^3.4.1",
    "@tiptap/extension-task-item": "^3.4.1",
    "@tiptap/extension-task-list": "^3.4.1",
    "@tiptap/markdown": "^3.4.1",
    "@tiptap/react": "^3.4.1",
    "@tiptap/starter-kit": "^3.4.1",
    "lucide-react": "^0.468.0",
    "marked": "^16.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "y-indexeddb": "^9.0.12",
    "y-prosemirror": "^1.3.7",
    "yjs": "^13.6.20"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
