# Database configuration (local PostgreSQL)
# Replace <your-username> with your PostgreSQL role (on Homebrew installs, usually your OS username).
# If DATABASE_URL is omitted, scripts/db-bootstrap.mjs defaults to the current OS user on 127.0.0.1:5432.
DATABASE_URL=postgresql://<your-username>@127.0.0.1:5432/realtime_markdown_editor
POSTGRES_HOST_PORT=5432

# Application ports
API_PORT=4000
WEB_PORT=5173
COLLAB_PORT=4001
# API 와 collab 이 공유하는 협업 연결 token 서명 값(32자 이상). 비워 두면 pnpm dev 가 실행마다 임의 값을 만든다.
# API 나 collab 을 따로 실행할 때는 반드시 설정한다.
RME_COLLAB_TOKEN_SECRET=
# 협업 연결 token 유효 시간(초). 기본값 120, 최대 900.
# RME_COLLAB_TOKEN_TTL_SECONDS=120
